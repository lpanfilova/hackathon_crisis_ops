# Example environment configuration. Copy to .env and adjust.
#   cp .env.example .env

# AWS region where your Bedrock access is provisioned.
AWS_REGION=us-east-1

# Bedrock model ID or inference profile for Claude Haiku 4.5.
# If your account requires a regional inference profile, prefix with the
# region, e.g. us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# Generation controls.
BEDROCK_MAX_TOKENS=512
BEDROCK_TEMPERATURE=0.0

# AWS credentials are normally picked up from your AWS CLI config.
# Uncomment to set them explicitly instead:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Stock reallocation (optimization/allocator.py) -------------------------
# All optional; defaults shown. Default planner: optimal | greedy | compare
ALLOCATOR_METHOD=optimal
# Planning window: trucks repeat round trips until these hours are used.
PLANNING_HORIZON_HOURS=6
AVG_SPEED_KMH=35
HANDLING_HOURS_PER_TRIP=0.5
# Solver budgets in seconds. Past the overall limit the planner falls back to greedy.
OPTIMIZER_TIME_LIMIT_S=10
OPTIMIZER_ROUNDING_TIME_S=1

# --- Database ----------------------------------------------------------------
# sqlite is the default. Set dynamodb to use one DynamoDB table for the mock
# world and every confirmed change. The process uses that database only; a
# missing credential or table is an error and is not written to SQLite instead.
# DATABASE_BACKEND=sqlite
# DYNAMODB_TABLE=crisisops
# DYNAMODB_SCENARIO=bay-county
